<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_menu">

    <fragment
        android:id="@+id/navigation_carrito"
        android:name="com.senatino.cavoshcafe202620.ui.Carrito"
        android:label="fragment_carrito"
        tools:layout="@layout/fragment_carrito" />
    <fragment
        android:id="@+id/navigation_splash"
        android:name="com.senatino.cavoshcafe202620.ui.Splash"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_navigation_splash_to_navigation_login"
            app:destination="@id/navigation_login" />
    </fragment>
    <fragment
        android:id="@+id/navigation_login"
        android:name="com.senatino.cavoshcafe202620.ui.Login"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" />
    <fragment
        android:id="@+id/navigation_favoritos"
        android:name="com.senatino.cavoshcafe202620.ui.Favoritos"
        android:label="fragment_favoritos"
        tools:layout="@layout/fragment_favoritos" />
    <fragment
        android:id="@+id/navigation_inicio"
        android:name="com.senatino.cavoshcafe202620.ui.Inicio"
        android:label="fragment_inicio"
        tools:layout="@layout/fragment_inicio" />
    <fragment
        android:id="@+id/navigation_registrar"
        android:name="com.senatino.cavoshcafe202620.ui.Registrar"
        android:label="fragment_registrar"
        tools:layout="@layout/fragment_registrar" />
    <fragment
        android:id="@+id/navigation_verificar"
        android:name="com.senatino.cavoshcafe202620.ui.Verificar"
        android:label="fragment_verificar"
        tools:layout="@layout/fragment_verificar" />
    <fragment
        android:id="@+id/navigation_perfil"
        android:name="com.senatino.cavoshcafe202620.ui.Perfil"
        android:label="fragment_perfil"
        tools:layout="@layout/fragment_perfil" />
    <fragment
        android:id="@+id/navigation_menu"
        android:name="com.senatino.cavoshcafe202620.ui.Menu"
        android:label="fragment_menu"
        tools:layout="@layout/fragment_menu" />
</navigation>